{
  "name": "steamhunters-plugin",
  "version": "2.1.1",
  "description": "A SteamHunters plugin for Millennium",
  "license": "MIT",
  "author": "BossSloth",
  "type": "module",
  "main": "./frontend/index.jsx",
  "scripts": {
    "dev": "millennium-ttc --build dev --watch",
    "sass": "sass ./public/achievements.scss ./public/achievements.css --style compressed --embed-sources --embed-source-map",
    "watch": "nodemon --watch public/achievements.scss --exec \"npm run sass && npm run dev\"",
    "build": "npm run sass && millennium-ttc --build prod",
    "typecheck": "bun check",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@steambrew/api": "^5.8.4",
    "@steambrew/client": "^5.8.5",
    "@steambrew/ttc": "^3.3.7",
    "@steambrew/webkit": "^5.8.4",
    "react-icons": "^5.7.0",
    "sass-embedded": "^1.105.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack": "^5.28.5",
    "chalk": "^6.0.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "semantic-release": "^25.0.9",
    "steam-types": "^2.2.0",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {
    "@steambrew/client@5.8.5": "patches/@steambrew%2Fclient@5.8.patch"
  }
}
